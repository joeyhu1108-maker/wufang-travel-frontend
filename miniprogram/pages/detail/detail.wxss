.detail { padding-bottom: 160rpx; }.cover { width: 100%; height: 600rpx; display: block; }.detail-body { padding: 40rpx 36rpx; }.subtitle { margin-top: 12rpx; }.story { margin-top: 44rpx; padding: 34rpx; }.story-copy { margin-top: 18rpx; }.tags { display: flex; gap: 12rpx; margin-top: 24rpx; }.tag { background: #e7efe9; color: #1e4b4a; padding: 10rpx 18rpx; border-radius: 999rpx; font-size: 22rpx; }.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 22rpx 36rpx calc(22rpx + env(safe-area-inset-bottom)); background: rgba(255,253,248,.96); display: flex; justify-content: space-between; align-items: center; box-shadow: 0 -10rpx 30rpx rgba(23,63,62,.08); }.price { color: #b77b45; font-size: 38rpx; font-weight: 600; }.price text { color: #7b817c; font-size: 22rpx; font-weight: 400; }.book { width: 270rpx; line-height: 82rpx; height: 82rpx; }
