<view class="page home">
  <view class="brand-row"><image class="logo-mark" src="/assets/wufang-logo.png" mode="aspectFit" aria-label="无方定版标志"/><view><view class="brand-name">WUFANG TRAVEL</view><view class="muted">有人托底的自由旅行</view></view></view>
  <view class="hero card">
    <view class="eyebrow">A JOURNEY BEYOND THE MAP</view>
    <view class="title"><view>去西藏，</view><view>把时间还给自己。</view></view>
    <view class="muted hero-copy">小团、深度、有人托底。去看一场只属于你的高原日落。</view>
    <view class="hero-orbit">བོད</view>
  </view>
  <view class="section-head"><view class="section-title">为你挑的旅程</view><button class="text-button" bindtap="openRoutes">查看全部 ›</button></view>
  <view class="status" wx:if="{{loading}}">正在加载路线…</view>
  <view wx:elif="{{error}}"><view class="error">{{error}}</view><button class="button secondary" bindtap="loadRoutes">重新加载</button></view>
  <view class="status" wx:elif="{{!featured.length}}">路线正在更新，请稍后再来。</view>
  <block wx:if="{{!loading && !error}}" wx:for="{{featured}}" wx:key="id">
    <view class="route-card card" data-id="{{item.id}}" bindtap="openDetail">
      <image class="route-cover" src="{{item.cover}}" mode="aspectFill" />
      <view class="route-info"><view class="eyebrow">{{item.duration}}</view><view class="route-title">{{item.title}}</view><view class="muted">{{item.subtitle}}</view><view class="route-bottom"><text>{{item.preview ? '参考价' : '咨询价'}} ¥{{item.price}} 起</text><text class="arrow">›</text></view></view>
    </view>
  </block>
</view>
