<view class="page">
  <view class="eyebrow">YOUR JOURNEY</view><view class="title">我的无方</view>
  <view class="profile card"><view class="avatar">{{logged ? '旅' : '无'}}</view><view><view class="section-title">{{logged ? '已登录' : '还没有登录'}}</view><view class="muted">{{logged ? '微信身份已确认' : '使用微信身份登录，不读取昵称或头像'}}</view></view></view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <button class="button" bindtap="handleLogin" loading="{{loading}}" disabled="{{loading || logged}}">{{loading ? '正在连接…' : (logged ? '已登录' : '微信登录')}}</button>
  <view class="muted note">登录不会公开你的个人资料。</view><button class="text-button" bindtap="openPrivacy">隐私说明 ›</button>
</view>
