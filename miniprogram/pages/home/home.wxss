.brand-row { display: flex; gap: 22rpx; align-items: center; margin-bottom: 42rpx; }
.logo-mark { width: 128rpx; height: 128rpx; flex-shrink: 0; }
.brand-name { color: #173f3e; font-size: 22rpx; letter-spacing: 3rpx; margin-bottom: 6rpx; }
.hero { min-height: 510rpx; padding: 44rpx; position: relative; overflow: hidden; margin-bottom: 52rpx; background: linear-gradient(145deg, #f2e8d5, #d8e7df); }
.hero .title { margin-top: 28rpx; position: relative; z-index: 1; }
.hero-copy { width: 76%; margin-top: 28rpx; position: relative; z-index: 1; }
.hero-orbit { position: absolute; right: -30rpx; bottom: -50rpx; color: rgba(30, 75, 74, .12); font-size: 260rpx; font-family: serif; transform: rotate(-12deg); }
.section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 22rpx; }
.route-card { overflow: hidden; margin-bottom: 28rpx; }
.route-cover { width: 100%; height: 290rpx; display: block; }
.route-info { padding: 30rpx; }
.route-title { color: #173f3e; font-size: 36rpx; font-weight: 600; margin: 14rpx 0 6rpx; }
.route-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 24rpx; color: #b77b45; font-size: 28rpx; font-weight: 600; }
.arrow { color: #1e4b4a; font-size: 38rpx; }
